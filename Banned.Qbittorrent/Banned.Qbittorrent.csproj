<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<PackageId>Banned.Qbittorrent</PackageId>
		<Version>1.8.0</Version>
		<IsAotCompatible>true</IsAotCompatible>
		<RepositoryUrl>https://github.com/banned2054/Banned.Qbittorrent</RepositoryUrl>
		<Authors>banned</Authors>
		<Copyright>Copyright (c) 2026 banned</Copyright>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Nullable>enable</Nullable>
		<Description>A .NET client library for qBittorrent's Web API</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			Version 1.8.0 adds Web API v2.16.2 category options and v2.17.0 features while preserving compatibility with older servers.

			- Adds metadata-fetch cancellation, torrent error details, and full search engine names (Web API v2.17.0).
			- Adds category share limits, optional category save-path updates, and tag/tracker removal confirmation preferences (Web API v2.16.2).
			- Fixes search result status deserialization without changing the existing public status type.
			- Preserves original five-parameter category method signatures, positional cancellation tokens, and legacy request behavior.
			- Expands old-server contract coverage and validates NativeAOT serialization with simulated responses.
		</PackageReleaseNotes>
		<PackageTags>qbittorrent;api;dotnet;httpclient</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<None Include="..\NOTICE" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<PackageId>Banned.Qbittorrent</PackageId>
		<Version>1.7.0</Version>
		<IsAotCompatible>true</IsAotCompatible>
		<RepositoryUrl>https://github.com/banned2054/Banned.Qbittorrent</RepositoryUrl>
		<Authors>banned</Authors>
		<Copyright>Copyright (c) 2026 banned</Copyright>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Nullable>enable</Nullable>
		<Description>A .NET client library for qBittorrent's Web API</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			Version 1.7.0 expands qBittorrent Web API coverage through v2.16.2 and adds qBittorrent 5.3.0 compatibility.

			- Adds API-key management, client-data storage, torrent metadata, SSL, piece-availability, and tracker reannounce support.
			- Adds combined speed limits, session pause/resume, free-space queries, RSS rule cloning, server-side file-path lookup, share-limits mode, and dotfile control.
			- Adds compatibility for qBittorrent 5.3.0 parameter changes and expands upstream parity tests.
			- Existing source calls generally remain compatible, but affected overloads with new optional parameters require recompilation of precompiled consumers.
		</PackageReleaseNotes>
		<PackageTags>qbittorrent;api;dotnet;httpclient</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<None Include="..\NOTICE" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>

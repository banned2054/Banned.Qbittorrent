<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<PackageId>Banned.Qbittorrent</PackageId>
		<Version>1.3.1</Version>
		<RepositoryUrl>https://github.com/banned2054/Banned.Qbittorrent</RepositoryUrl>
		<Authors>banned</Authors>
		<Copyright>Copyright (c) 2026 banned</Copyright>
		<ImplicitUsings>enable</ImplicitUsings>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Nullable>enable</Nullable>
		<Description>A .NET client library for qBittorrent's Web API</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>
			Version 1.3.1 improves qBittorrent Web API authentication recovery.

			- Retried requests once after 401/403 responses by forcing a fresh login.
			- Allowed Web API version negotiation to recover from 403 responses after qBittorrent restarts.
			- Treated empty login responses as successful, matching newer qBittorrent behavior.
			- Added request URL context to network timeout errors.
		</PackageReleaseNotes>
		<PackageTags>qbittorrent;api;dotnet;httpclient</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<None Include="..\NOTICE" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
